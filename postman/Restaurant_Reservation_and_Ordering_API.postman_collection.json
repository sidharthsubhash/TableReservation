    {
      "name": "05 - Table Reservation Engine",
      "item": [
        {
          "name": "Check Slot Availability for Date",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reservations/availability?branchId={{branchId}}&date=2026-09-10&partySize=4",
              "host": ["{{baseUrl}}"],
              "path": ["reservations", "availability"],
              "query": [
                { "key": "branchId", "value": "{{branchId}}" },
                { "key": "date", "value": "2026-09-10" },
                { "key": "partySize", "value": "4" }
              ]
            }
          }
        },
        {
          "name": "Create Table Reservation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.reservation) {",
                  "    pm.collectionVariables.set('reservationId', jsonData.data.reservation._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branchId\": \"{{branchId}}\",\n  \"tableId\": \"{{tableId}}\",\n  \"partySize\": 2,\n  \"reservationDate\": \"2026-09-10\",\n  \"startTime\": \"20:00\",\n  \"durationMinutes\": 90,\n  \"specialRequests\": \"Window seat preferred\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/reservations", "host": ["{{baseUrl}}"], "path": ["reservations"] }
          }
        },
        {
          "name": "Cancel Reservation (Policy Checked)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cancellationReason\": \"Change of personal plans\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/reservations/{{reservationId}}/cancel", "host": ["{{baseUrl}}"], "path": ["reservations", "{{reservationId}}", "cancel"] }
          }
        },
        {
          "name": "Reschedule Reservation",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newDate\": \"2026-09-11\",\n  \"newStartTime\": \"19:00\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/reservations/{{reservationId}}/reschedule", "host": ["{{baseUrl}}"], "path": ["reservations", "{{reservationId}}", "reschedule"] }
          }
        }
      ]
