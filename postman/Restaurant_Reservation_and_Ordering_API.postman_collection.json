    {
      "name": "02 - Branch Management",
      "item": [
        {
          "name": "Get All Branches",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.branches && jsonData.data.branches.length > 0) {",
                  "    pm.collectionVariables.set('branchId', jsonData.data.branches[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/branches", "host": ["{{baseUrl}}"], "path": ["branches"] }
          }
        },
        {
          "name": "Get Branch by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/branches/{{branchId}}", "host": ["{{baseUrl}}"], "path": ["branches", "{{branchId}}"] }
          }
        },
        {
          "name": "Create New Branch (Admin/Manager)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"The Royal Feast - MG Road\",\n  \"code\": \"MGR04\",\n  \"address\": {\n    \"street\": \"Trinity Circle, MG Road\",\n    \"city\": \"Bangalore\",\n    \"state\": \"Karnataka\",\n    \"zipCode\": \"560001\"\n  },\n  \"phone\": \"+91 80 2555 9999\",\n  \"email\": \"mgroad@royalfeast.com\",\n  \"totalSeatingCapacity\": 90,\n  \"openingTime\": \"11:00\",\n  \"closingTime\": \"23:30\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/branches", "host": ["{{baseUrl}}"], "path": ["branches"] }
          }
        }
      ]
    },
    {
      "name": "03 - Menu Management",
      "item": [
        {
          "name": "Get All Menu Items (Filtered)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.menuItems && jsonData.data.menuItems.length > 0) {",
                  "    pm.collectionVariables.set('menuItemId', jsonData.data.menuItems[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/menu?category=Main Course&dietary=non-veg",
              "host": ["{{baseUrl}}"],
              "path": ["menu"],
              "query": [
                { "key": "category", "value": "Main Course" },
                { "key": "dietary", "value": "non-veg" }
              ]
            }
          }
        },
        {
          "name": "Create Menu Item (Admin/Manager)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Shahi Rogan Josh\",\n  \"description\": \"Kashmiri aromatic lamb curry cooked with traditional spices and ratan jot\",\n  \"category\": \"Main Course\",\n  \"dietary\": \"non-veg\",\n  \"price\": 540,\n  \"preparationTimeMinutes\": 25,\n  \"isAvailable\": true,\n  \"isSpecial\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/menu", "host": ["{{baseUrl}}"], "path": ["menu"] }
          }
        },
